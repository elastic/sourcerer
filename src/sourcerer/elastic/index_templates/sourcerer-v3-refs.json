{
  "_meta": {
    "description": "sourcerer-refs"
  },
  "index_patterns": [
    "sourcerer-v3-refs*"
  ],
  "template": {
    "aliases": {
      "sourcerer-refs": {}
    },
    "settings": {
      "index": {
        "codec": "best_compression",
        "mode": "lookup",
        "sort": {
          "field": [
            "git.host",
            "git.org",
            "git.repo",
            "git.ref"
          ],
          "order": [
            "asc",
            "asc",
            "asc",
            "asc"
          ]
        }
      }
    },
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword"
            }
          }
        }
      ],
      "properties": {
        "git": {
          "properties": {
            "host": {
              "type": "keyword",
              "normalizer": "lowercase"
            },
            "org": {
              "type": "keyword",
              "normalizer": "lowercase"
            },
            "repo": {
              "type": "keyword",
              "normalizer": "lowercase"
            },
            "ref": {
              "type": "keyword"
            },
            "ref_type": {
              "type": "keyword",
              "normalizer": "lowercase"
            },
            "commit": {
              "type": "keyword",
              "normalizer": "lowercase"
            },
            "commit_date": {
              "type": "date"
            },
            "commit_target": {
              "type": "keyword",
              "normalizer": "lowercase"
            }
          }
        },
        "status": {
          "type": "keyword",
          "normalizer": "lowercase"
        },
        "files_count": {
          "type": "long"
        },
        "lines_count": {
          "type": "long"
        },
        "indexed_at": {
          "type": "date"
        },
        "indexing_started_at": {
          "type": "date"
        },
        "index_level": {
          "type": "keyword",
          "normalizer": "lowercase"
        },
        "index_suffix": {
          "type": "keyword",
          "normalizer": "lowercase"
        },
        "mode": {
          "type": "keyword",
          "normalizer": "lowercase"
        }
      }
    }
  }
}